{
    "agent_id": "jump-server-01",
    "pypnm_server": {
        "url": "ws://127.0.0.1:8000/api/agents/ws",
        "auth_token": "your-secure-token-here"
    },
    "workers": {
        "_comment": "Dedicated agent worker pools; GUI maps to PyPNM interactive priority",
        "gui": 50,
        "bulk": 2,
        "identity": 8,
        "long": 10
    },
    "peer_tunnels": [
        {
            "_comment": "Reverse SSH tunnel to CM agent host: opens remote_port on ssh_host so the CM agent can reach PyPNM via localhost:remote_port there",
            "label": "cm-agent",
            "enabled": false,
            "ssh_host": "cm-agent-host.internal",
            "ssh_port": 22,
            "ssh_user": "svdleer",
            "key_file": "~/.ssh/id_ed25519",
            "ssh_options": [
                "PreferredAuthentications=publickey",
                "PubkeyAuthentication=yes",
                "IdentitiesOnly=yes"
            ],
            "local_port": 8000,
            "remote_port": 8000
        },
        {
            "_comment": "Reverse SSH tunnel to get-file agent host: opens remote_port so the file agent can reach PyPNM via localhost:remote_port there",
            "label": "file-agent",
            "enabled": false,
            "ssh_host": "file-agent-host.internal",
            "ssh_port": 22,
            "ssh_user": "svdleer",
            "key_file": "~/.ssh/id_ed25519",
            "ssh_options": [
                "PreferredAuthentications=publickey",
                "PubkeyAuthentication=yes",
                "IdentitiesOnly=yes"
            ],
            "local_port": 8000,
            "remote_port": 8001
        }
    ],
    "cm_poller_mysql": {
        "_comment": "Default-disabled read-only inventory source; keep this local config owner-readable and never commit real credentials",
        "enabled": false,
        "host": "127.0.0.1",
        "database": "cm_poller",
        "user": "cm_poller_readonly",
        "password": "replace-with-local-password",
        "connect_timeout": 5,
        "read_timeout": 30,
        "page_size": 1000,
        "response_byte_max": 4194304
    },
    "cmts_list": [
        {
            "name": "cmts-01",
            "ip": "192.0.2.10",
            "community": "your-cmts-read-community",
            "write_community": "your-cmts-write-community",
            "vendor": "vendor-name",
            "type": "platform-type"
        }
    ],
    "cmts_access": {
        "enabled": true,
        "community": "your-cmts-read-community",
        "write_community": "your-cmts-write-community",
        "ssh_enabled": false,
        "ssh_user": "admin",
        "ssh_key_file": "~/.ssh/id_ed25519"
    },
    "cm_access": {
        "enabled": true,
        "community": "your-cm-read-community",
        "write_community": "your-cm-write-community",
        "proxy": {
            "host": "cm-proxy.internal",
            "user": "pnm-agent",
            "key_file": "~/.ssh/id_ed25519"
        }
    },
    "tftp_server": {
        "tftp_path": "/tftpboot"
    }
}
